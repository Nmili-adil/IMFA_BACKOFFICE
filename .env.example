# Supabase Configuration
# Copy this file to .env.local for development or .env for Docker
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note for Docker:
# These variables are used at BUILD TIME by Vite
# They are baked into the JavaScript bundle during compilation



roles => enum (without data)
const RolesUnum = ['Admin','Manager', 'Supper admin', 'User'] as const;

user = {
    name,
    birth_day,
     role: string (RolesUnum[0])
}

